# Configuración del servidor
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True

# Configuración de COLMAP API (Fotogrametría gratuita open source)
COLMAP_API_URL=http://localhost:8001
# COLMAP se ejecutará en el puerto 8001 para no conflictuar con este backend (8000)

# Configuración de APIs de IA 3D (opcional)
# MESHY_API_KEY=your_meshy_api_key
# TRIPO3D_API_KEY=your_tripo3d_api_key
# LUMA_API_KEY=your_luma_api_key

# Configuración de procesamiento
MAX_UPLOAD_BYTES=524288000
MAX_TOTAL_UPLOAD_BYTES=1073741824
MAX_IMAGE_COUNT=100
ALLOWED_VIDEO_FORMATS=mp4,avi,mov,mkv
MAX_CONCURRENT_JOBS=3

# Configuración de almacenamiento
UPLOAD_DIR=uploads
FRAMES_DIR=frames
OUTPUT_DIR=output
TEMP_DIR=temp

# Configuración de CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
